# ===========================================
# INFRASTRUCTURE
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vortyx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================================
# ZITADEL CORE
# ===========================================
ZITADEL_DOMAIN=localhost:8080
ZITADEL_ISSUER=http://localhost:8080

# ===========================================
# ZITADEL ORGANIZATION & PROJECT
# ===========================================
# vortyx-org resource ID (get from Zitadel Console → Organizations)
ZITADEL_ORG_ID=your-org-id

# vortyx-platform project ID (get from Zitadel Console → Projects)
# Used as: project ID, token audience, and client ID fallback
ZITADEL_PROJECT_ID=your-project-id

# ===========================================
# ZITADEL CREDENTIALS
# ===========================================
# Backend API App (JWT Bearer Grant)
# Get from: Zitadel Console → Projects → vortyx-platform → vortyx-api → Keys
# This is an "application" type app with a machine key
ZITADEL_BACKEND_API_KEY=./json secrets/vort-api-key.json
ZITADEL_BACKEND_API_ID=your-api-key-id

# Management PAT (IAM OWNER service user) - Only for org management operations
# Get from: Zitadel Console → Users → [IAM OWNER service user] → Personal Access Tokens
# WARNING: Only use for create/delete organizations, not regular operations
ZITADEL_MANAGEMENT_PAT=your-pat-token-here

# ===========================================
# FRONTEND APP (vortyx-frontend)
# ===========================================
# OIDC Web Application in vortyx-platform project
ZITADEL_CLIENT_ID=your-frontend-client-id
ZITADEL_CLIENT_SECRET=your-frontend-client-secret

# ===========================================
# VORT AGENT (vort-agent Service User)
# ===========================================
# Service User (JWT Profile Grant)
# Get from: Zitadel Console → Users → vort-agent → Keys
# This is a "serviceaccount" type - used by edge agents to authenticate with backend
ZITADEL_VORT_SERVICE_USER_KEY_PATH=./json secrets/vort-agent-key.json
ZITADEL_VORT_SERVICE_USER_KEY_ID=your-agent-key-id

# ===========================================
# AGENT JWT CONFIG (Internal token generation)
# ===========================================
# ZITADEL_VORT_AGENT_JWT_PRIVATE_KEY=  # Auto-generated if empty
# ZITADEL_VORT_AGENT_JWT_ISSUER=vortyx-agent-auth
# ZITADEL_AGENT_JWT_AUDIENCE=vortyx-api

# ===========================================
# BACKEND SERVER
# ===========================================
PORT=8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vortyx?sslmode=disable
ENV=development

# ===========================================
# FRONTEND (Next.js)
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-min-32-chars
AUTH_SECRET=your-random-secret-min-32-chars
NEXT_PUBLIC_API_URL=http://localhost:8081
